{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "test": "node --test test/*.test.js",
    "test:site": "npm run clean && npm run build && npm test",
    "cms:local": "node tools/local-cms.js",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "pub": "hexo clean && hexo g && hexo d",
