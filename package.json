{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "test": "node --test test/*.test.js",
    "test:html": "html-validate 'public/**/*.html'",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:e2e:cross-browser": "playwright test",
    "test:visual": "RUN_VISUAL_REGRESSION=1 playwright test test/e2e/visual.spec.js --project=chromium-desktop --project=chromium-mobile",
    "test:visual:update": "RUN_VISUAL_REGRESSION=1 playwright test test/e2e/visual.spec.js --project=chromium-desktop --project=chromium-mobile --update-snapshots=all",
    "test:lighthouse": "lhci autorun",
    "test:site": "npm run clean && npm run build && npm test",
    "test:quality": "npm run test:site && npm run test:html && npm run test:e2e && npm run test:lighthouse",
    "test:security": "npm audit --audit-level=high",
    "cms:local": "LOCAL_CMS_AUTO_SHUTDOWN=0 node tools/local-cms.js",
    "cms:themes": "node tools/local-cms/generate-school-theme-css.js",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "pub": "hexo clean && hexo g && hexo d",
    "gallery:sync": "node tools/gallery-sync.js",
    "gallery:list": "node tools/gallery-cli.js list-albums",
    "gallery:add-album": "node tools/gallery-cli.js add-album",
    "gallery:add-photo": "node tools/gallery-cli.js add-photo",
    "images:normalize": "node tools/normalize-image-filenames.js"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index-i18n": "^0.2.1",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-symbols-count-time": "^0.7.1",
    "hexo-theme-landscape": "^1.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "hexo-symbols-count-time": {
      "hexo-util": "3.3.0"
    },
    "inquirer": "8.2.7",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "html-validate": "^11.5.6"
  }
}
