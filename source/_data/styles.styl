/* =============================================
   编辑型内容流：规整网格 + 带缩略图的索引列表
   ============================================= */

/* The previous feed used CSS columns, which made the reading order jump
   between columns and produced uneven card heights. Keep the feed on one
   predictable layout axis so the visual order always matches the DOM order. */
.main .content.feed-page.posts-expand
  column-count: initial
  column-gap: 0
  display: block

.main .content.feed-page .feed-posts-container
  column-span: none

/* ---- Card view: editorial grid ---- */
.main .content.feed-page.feed-view-card .feed-posts-container
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 24px
  align-items: stretch
  grid-auto-flow: row
  width: 100%

.main .content.feed-page.feed-view-card .post-block
  box-sizing: border-box
  display: flex
  flex-direction: column
  min-width: 0
  min-height: 552px
