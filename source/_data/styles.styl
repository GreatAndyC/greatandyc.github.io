  opacity: 1

.gallery-viewer-thumb img
  width: 100%
  height: 100%
  object-fit: cover
  display: block

.gallery-albums
  display: flex
  flex-direction: column
  gap: 42px

.gallery-album
  display: flex
  flex-direction: column
  gap: 18px

.gallery-album-header
  display: flex
  justify-content: space-between
  gap: 24px
  align-items: flex-end

.gallery-album-kicker
  margin: 0 0 8px
  font-size: 0.85rem
  letter-spacing: 0.08em
  text-transform: uppercase
  color: #7b8b99

.gallery-album-title
  margin: 0
  font-size: 1.9rem
  line-height: 1.15

.gallery-album-description
  max-width: 720px
  margin: 12px 0 0
