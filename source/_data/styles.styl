/* =============================================
   文章内演示文稿横向浏览器
   ============================================= */

.post-body .post-deck-gallery
  --deck-paper: var(--content-bg-color, #fff)
  --deck-canvas: var(--body-bg-color, #f3f3f3)
  --deck-ink: var(--text-color, #222)
  --deck-muted: #666
  margin 2.2em 0
  overflow hidden
  border 1px solid rgba(80, 80, 80, 0.24)
  background var(--deck-canvas)

.post-body .post-deck-gallery__toolbar
  display flex
  min-height 48px
  align-items center
  justify-content space-between
  gap 16px
  padding 0 16px
  border-bottom 1px solid rgba(80, 80, 80, 0.24)
  background var(--deck-paper)
  color var(--deck-ink)
  font-size 0.78rem
  line-height 1.4

.post-body .post-deck-gallery__toolbar strong
  font-weight 700

.post-body .post-deck-gallery__hint
  color var(--deck-muted)
  text-align right

.post-body .post-deck-gallery__track
  display grid
  grid-auto-columns min(88%, 760px)
  grid-auto-flow column
  gap 1px
  overflow-x auto
  overscroll-behavior-x contain
  padding 16px 12% 18px 16px
  background var(--deck-canvas)
  scrollbar-color var(--deck-ink) var(--deck-canvas)
  scrollbar-width thin
  scroll-snap-type x mandatory
  -webkit-overflow-scrolling touch

.post-body .post-deck-gallery__track::-webkit-scrollbar
  height 8px

.post-body .post-deck-gallery__track::-webkit-scrollbar-track
  background var(--deck-canvas)

.post-body .post-deck-gallery__track::-webkit-scrollbar-thumb
  background var(--deck-ink)

.post-body .post-deck-gallery__slide
  display grid
  grid-template-rows auto auto
  min-width 0
  margin 0
  overflow hidden
  border 1px solid rgba(80, 80, 80, 0.24)
  background var(--deck-paper)
  scroll-snap-align start
  scroll-snap-stop always

.post-body .post-deck-gallery__slide img
  display block
  width 100%
  max-width 100%
  height auto
  aspect-ratio 16 / 9
  box-sizing border-box
  margin 0
  padding 10px
  background #171a2b
  object-fit contain
  object-position center

.post-body .post-deck-gallery__slide figcaption
  min-height 52px
  margin 0
  padding 14px 16px
  border-top 1px solid rgba(80, 80, 80, 0.18)
  background var(--deck-paper)
  color var(--deck-muted)
