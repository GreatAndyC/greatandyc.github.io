.gallery-viewer-status
  color: rgba(255, 255, 255, 0.58)
  font-size: 0.82rem
  white-space: nowrap

.gallery-viewer-thumbs
  display: flex
  gap: 10px
  overflow-x: auto
  padding-bottom: 2px

.gallery-viewer-thumb
  flex: 0 0 74px
  width: 74px
  height: 52px
  padding: 0
