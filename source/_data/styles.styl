    margin: 0
    pointer-events: auto

  .site-rail-sidebar
    width: 100%
    margin: 0
    pointer-events: none

  .site-rail-sidebar > .sidebar
    position: static
    display: block
    width: $sidebar-desktop
    margin: 0
    pointer-events: auto

  .site-rail-sidebar .sidebar-inner.affix,
  .site-rail-sidebar .sidebar-inner.affix-top,
  .site-rail-sidebar .sidebar-inner.affix-bottom
    position: static
    top: auto
    bottom: auto
    max-height: none
    overflow: visible

  .sidebar-layout-spacer
    flex: 0 0 $sidebar-desktop
    width: $sidebar-desktop

  .header
    position: fixed
    top: 0
    left: 0
    right: 0
    z-index: 100
    margin: 0 auto
    pointer-events: none

  .header-inner
    pointer-events: auto
    border-radius: 0
    box-shadow: none

  .header-inner .main-menu
    margin-top: 12px
    margin-bottom: 0

  .header-inner .menu-item-language .language-switcher
    margin-top: 4px

  .sidebar-inner.affix
    top: var(--sidebar-affix-top, 0px)
    border-radius: 0 0 2px 2px
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.10)
    max-height: calc(100vh - var(--sidebar-affix-top, 0px) - 16px)
    overflow-y: auto
    overscroll-behavior: contain
    scrollbar-width: thin

  .sidebar-inner.affix .site-overview-wrap
    max-height: none !important
    overflow: visible !important

  .sidebar-inner.affix .site-author-image
    box-sizing: border-box
    width: 72px
    height: 72px
    max-width: 72px
    margin: 0 auto 6px
    padding: 2px

  .sidebar-inner.affix .site-author-name
    margin: 0
    font-size: 0.95rem
    line-height: 1.35

  .sidebar-inner.affix .site-description
    margin-top: 2px
    font-size: 0.75rem
    line-height: 1.35

  .sidebar-inner.affix .site-state
    margin-top: 10px
    line-height: 1.2

  .sidebar-inner.affix .site-state-item
    padding: 0 8px

  .sidebar-inner.affix .site-state-item-count
    font-size: 1.05rem
    line-height: 1.1

  .sidebar-inner.affix .site-state-item-name
    font-size: 0.68rem
    line-height: 1.2

  .sidebar-inner.affix .links-of-author
    margin-top: 9px

  .sidebar-inner.affix .links-of-author-item
    margin: 0

  .sidebar-inner.affix .links-of-author-item a
    margin: 0 8px 0 0
    font-size: 0.72rem

  .sidebar-inner.affix .links-of-blogroll
    margin-top: 7px
    font-size: 0.72rem

  .sidebar-inner.affix .links-of-blogroll-title,
  .sidebar-inner.affix .links-of-blogroll-list
    line-height: 1.3

  .sidebar-inner.affix .links-of-blogroll-title
    font-size: 0.72rem

  .mobile-rail-profile
    display: none

  .sidebar-inner.affix::-webkit-scrollbar
    width: 4px

  .sidebar-inner.affix::-webkit-scrollbar-thumb
    background: rgba(90, 90, 90, 0.28)
    border-radius: 4px

@media (max-width: 991px)
  .site-rail
    position: static
    overflow: visible
    pointer-events: auto

  .site-rail-sidebar
    display: none

  .sidebar-layout-spacer
    display: none

  html.rail-drawer-open,
  html.rail-drawer-open body
    overflow: hidden

  .site-nav.site-nav-on
    position: fixed
    z-index: 110
    top: var(--rail-header-offset, 79px)
    right: 0
    left: 0
    box-sizing: border-box
    height: auto
    max-height: calc(100vh - var(--rail-header-offset, 79px))
    padding: 12px 0 calc(12px + env(safe-area-inset-bottom, 0px))
    overflow-x: hidden
    overflow-y: auto
    overscroll-behavior: contain
    background: var(--content-bg-color, #fff)
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18)

  .mobile-rail-profile
    box-sizing: border-box
    display: flex
    align-items: center
    width: 100%
    max-width: 520px
    gap: 12px
    margin: 0 auto 8px
    padding: 0 24px 4px
    border-bottom: 1px solid rgba(110, 110, 110, 0.16)

  .mobile-rail-profile-image
    box-sizing: border-box
    flex: 0 0 56px
    width: 56px
    height: 56px
    margin: 0
    border: 2px solid rgba(110, 110, 110, 0.14)
    border-radius: 50%
    object-fit: cover

  .mobile-rail-profile-copy
    display: flex
    flex: 1 1 auto
    min-width: 0
    flex-direction: column
    gap: 3px

  .mobile-rail-profile-name
    color: var(--text-color)
    font-size: 0.95rem
    line-height: 1.3

  .mobile-rail-profile-description
    overflow: hidden
    color: #666
    font-size: 0.78rem
    line-height: 1.4
    text-overflow: ellipsis
    white-space: nowrap

  .site-nav.site-nav-on .main-menu
    width: 100%
    max-width: 520px
    margin-top: 0
    margin-bottom: 0
    margin-left: auto
    margin-right: auto

  .site-nav.site-nav-on .main-menu > .menu-item
    margin: 0

  .site-nav.site-nav-on .main-menu > .menu-item > a
    box-sizing: border-box
    display: flex
    align-items: center
    min-height: 44px
    padding: 7px 24px
    font-size: 1rem
    line-height: 1.35

  .site-nav.site-nav-on .main-menu > .menu-item > a .fa,
  .site-nav.site-nav-on .main-menu > .menu-item > a .fab,
  .site-nav.site-nav-on .main-menu > .menu-item > a .far,
  .site-nav.site-nav-on .main-menu > .menu-item > a .fas
    flex: 0 0 20px
    width: 20px
    margin-right: 12px
    text-align: center

  .site-nav.site-nav-on .main-menu > .menu-section-label
    display: block
    box-sizing: border-box
    width: auto
    margin: 16px 24px 6px

  .site-nav.site-nav-on .main-menu > .menu-item-language
    padding: 0 24px

  .site-nav.site-nav-on .main-menu > .menu-item-language .language-switcher
    width: 100%
    height: 52px
    min-height: 52px
    margin: 8px 0 0
    padding: 8px 0 0

  .mobile-rail-links
    display: block
    box-sizing: border-box
    width: 100%
    max-width: 520px
    margin: 12px auto 0
    padding: 12px 24px 0
    border-top: 1px solid rgba(110, 110, 110, 0.16)

  .mobile-rail-links-heading
    display: flex
    align-items: center
    gap: 8px
    margin-bottom: 4px
    color: #666
    font-size: 0.68rem
    font-weight: 700
    letter-spacing: 0.12em
    line-height: 1.3
    text-transform: uppercase

  .mobile-rail-links-heading .fa,
  .mobile-rail-links-heading .fab,
  .mobile-rail-links-heading .far,
  .mobile-rail-links-heading .fas
    width: 16px
    color: #777
    text-align: center

  .mobile-rail-links-list
    display: flex
    flex-wrap: wrap
    align-items: center
    gap: 2px 18px

  .mobile-rail-links-list .mobile-rail-link
    display: inline-flex
    align-items: center
    min-height: 40px
    gap: 7px
    color: #555
    font-size: 0.86rem
    line-height: 1.3
    text-decoration: none
    white-space: nowrap

  .mobile-rail-links-list .mobile-rail-link:hover,
  .mobile-rail-links-list .mobile-rail-link:focus-visible
    color: var(--link-hover-color, #c44)

  .mobile-rail-links-list .mobile-rail-link .fa,
  .mobile-rail-links-list .mobile-rail-link .fab,
  .mobile-rail-links-list .mobile-rail-link .far,
  .mobile-rail-links-list .mobile-rail-link .fas
    flex: 0 0 16px
    width: 16px
    text-align: center
