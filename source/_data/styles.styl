/* =============================================
   Header 语言切换：用紧凑的双语导航替代原生下拉菜单
   ============================================= */

.site-nav .menu .menu-item-language
  vertical-align: middle

.site-nav .menu .menu-item-language .language-switcher
  display: flex
  align-items: center
  box-sizing: border-box
  height: 56px
  min-height: 56px
  width: 100%
  margin: 8px 0 0
  padding: 8px 20px 0
  border-top: 1px solid rgba(110, 110, 110, 0.16)
  font-size: 0.86em
  line-height: 1
  white-space: nowrap

.site-nav .menu .menu-item-language .language-switcher-label
  margin-right: 14px
  color: #666
  font-size: 0.66em
  font-weight: 600
  letter-spacing: 0.11em
  line-height: 1
  text-transform: uppercase

.site-nav .menu .menu-item-language .language-switcher-options
  display: inline-flex
  align-items: center
  height: 44px
  gap: 8px

.site-nav .menu .menu-item-language .language-switcher-option
  display: inline-flex
  align-items: center
  justify-content: center
  box-sizing: border-box
  height: 44px
  min-width: 40px
  min-height: 44px
  padding: 11px 4px
  border-bottom: 2px solid transparent
  color: var(--text-color)
  font-size: 0.82em
  font-weight: 600
  letter-spacing: 0.06em
  line-height: 1
  text-align: center
  transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease

.site-nav .menu .menu-item-language .language-switcher-option:hover
  color: var(--link-hover-color)
  background: transparent
  border-bottom-color: var(--link-hover-color)

.site-nav .menu .menu-item-language .language-switcher-option.is-current
  color: var(--link-hover-color)
  border-bottom-color: var(--link-hover-color)
  cursor: default

.site-nav .menu .menu-item-language .language-switcher-option:focus-visible
  outline: 2px solid var(--link-hover-color)
  outline-offset: 2px
  border-radius: 2px

.site-nav .menu .menu-item-language .language-switcher-divider
  display: inline-block
  color: rgba(90, 90, 90, 0.46)
  font-size: 0.82em
  font-weight: 400
  line-height: 1

@media (prefers-reduced-motion: reduce)
  .site-nav .menu .menu-item-language .language-switcher-option
    transition: none

/* =============================================
   Work page v2 — monochrome editorial portfolio
   ============================================= */

.post-block.page-type-portfolio
  box-sizing: border-box
  width: 100%
  max-width: 1080px
  margin-right: auto
  margin-left: auto

.post-block.page-type-portfolio .post-header
  display: none

.post-block.page-type-portfolio .post-body
  max-width: none
  word-break: normal
  overflow-wrap: anywhere

.work-page
  --work-paper: #fff
  --work-ink: #222
  --work-muted: #666
  --work-line: #d8d8d8
  --work-strong-line: #222
  --work-canvas: #f3f3f3
  color: var(--work-ink)
  font-family: inherit
  text-align: left

.work-page *,
.work-page *::before,
.work-page *::after
  box-sizing: border-box

.work-page h1,
.work-page h2,
.work-page p,
.work-page figure,
.work-page dl,
.work-page dd
