/* =============================================
   首页瀑布流卡片布局
   ============================================= */

.main .content.index.posts-expand
  column-count: 3
  column-gap: 24px
  padding-top: 10px

.main .content.index.posts-expand .post-block
  break-inside: avoid-column
  margin-top: 0
  margin-bottom: 24px
  padding: 0 /* 移除外层以便图片贴边 */
  border-radius: 18px
  background: var(--content-bg-color, #fff)
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06)
  transition: transform .2s ease, box-shadow .2s ease
  display: flex
  flex-direction: column
  overflow: hidden

.main .content.index.posts-expand .post-block:hover
  transform: translateY(-4px)
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.10)

.main .content.index.posts-expand .post-header
  padding: 20px 20px 0 20px
  margin-bottom: 12px
  text-align: left

.main .content.index.posts-expand .post-title
  font-size: 1.1rem
  font-weight: 600
  line-height: 1.45
  margin: 0 0 10px 0
  display: -webkit-box
  -webkit-line-clamp: 2
  -webkit-box-orient: vertical
  overflow: hidden
  text-align: left
  justify-content: flex-start

.main .content.index.posts-expand .post-meta
  font-size: 0.82rem
  opacity: .75
  margin-bottom: 12px
  display: flex
  flex-direction: column
  align-items: flex-start
  gap: 2px

.main .content.index.posts-expand .post-meta .post-meta-item
  justify-content: flex-start

.main .content.index.posts-expand .post-meta .post-meta-item + .post-meta-item::before
  display: none

.main .content.index.posts-expand .post-meta br
  display: none

.main .content.index.posts-expand .post-body
  padding: 0 20px 20px 20px
  flex: 1
  display: flex
  flex-direction: column
  text-align: left

.main .content.index.posts-expand .post-body p
  margin-top: 0
  margin-bottom: 8px
  color: #666
  font-size: 0.9em
  line-height: 1.6
  display: -webkit-box
  -webkit-line-clamp: 3
  -webkit-box-orient: vertical
  overflow: hidden
  text-overflow: ellipsis

.main .content.index.posts-expand .post-body img
  width: calc(100% + 40px) !important
  max-width: calc(100% + 40px) !important
  height: auto !important
  object-fit: cover !important
  margin: -10px -20px 12px -20px !important
  display: block !important
  border: none !important
  box-shadow: none !important
  border-radius: 0 !important

.main .content.index.posts-expand .post-eof
  display: none

/* 首页分页横跨所有列 */
.main .content.index .pagination
  margin-top: 32px
  column-span: all
  width: 100%

@media (max-width: 991px)
  .main .content.index.posts-expand
    column-count: 2

@media (max-width: 767px)
  .main .content.index.posts-expand
    column-count: 1

/* =============================================
   文章内图片样式（缩小居中 + 图注）
   ============================================= */

.post-body img
  display block
  max-width 70%
  margin 0 auto

.post-body img + em
  display block
  text-align center
  color #999
  font-size 0.85em
  margin-top -1em

.post-body
  word-break break-all

/* =============================================
   画廊页面样式
   ============================================= */

.gallery-content
  display: flex
  flex-direction: column
  gap: 28px

.gallery-page
  display: flex
  flex-direction: column
  gap: 28px

.gallery-nav
  display: flex
  flex-wrap: wrap
  gap: 10px
  padding-bottom: 8px

.gallery-nav-link
  display: inline-flex
  align-items: center
  gap: 8px
  padding: 10px 14px
  border-radius: 999px
  background: rgba(70, 130, 180, 0.08)
  color: #2e5372
  font-size: 0.92rem
  border: 1px solid rgba(70, 130, 180, 0.18)
  transition: all .2s ease

.gallery-nav-link:hover
  background: rgba(70, 130, 180, 0.14)
  border-color: rgba(70, 130, 180, 0.28)
  color: #1f415c

.gallery-nav-link span
  display: inline-flex
  align-items: center
  justify-content: center
  min-width: 22px
  height: 22px
  padding: 0 6px
  border-radius: 999px
  background: rgba(255, 255, 255, 0.85)
  font-size: 0.76rem

.gallery-albums
  display: flex
  flex-direction: column
  gap: 42px

.gallery-album
  display: flex
  flex-direction: column
  gap: 18px

.gallery-album-header
  display: flex
  justify-content: space-between
  gap: 24px
  align-items: flex-end

.gallery-album-kicker
  margin: 0 0 8px
  font-size: 0.85rem
  letter-spacing: 0.08em
  text-transform: uppercase
  color: #7b8b99

.gallery-album-title
  margin: 0
  font-size: 1.9rem
  line-height: 1.15

.gallery-album-description
  max-width: 720px
  margin: 12px 0 0
  color: #65727f
  line-height: 1.8

.gallery-album-meta
  display: flex
  flex-direction: column
  align-items: flex-end
  gap: 6px
  font-size: 0.86rem
  color: #7b8b99
  text-align: right

.gallery-album-tags
  display: flex
  flex-wrap: wrap
  gap: 8px

.gallery-album-tags span
  padding: 5px 10px
  border-radius: 999px
  background: #f2f5f8
  color: #51606d
  font-size: 0.82rem

.gallery-photo-grid
  column-count: 2
  column-gap: 20px

.gallery-photo-card
  display: inline-block
  width: 100%
  margin: 0 0 20px
  overflow: hidden
  border-radius: 18px
  background: #fff
  box-shadow: 0 10px 28px rgba(17, 28, 45, 0.08)
  border: 1px solid rgba(17, 28, 45, 0.05)
  break-inside: avoid
  -webkit-column-break-inside: avoid

.gallery-photo-frame
  display: block
  border: none

.gallery-photo-frame img
  display: block
  width: 100%
  height: auto
  margin: 0

.gallery-photo-copy
  display: flex
  flex-direction: column
  gap: 8px

/* =============================================
   Profile 页面头像
   ============================================= */

.profile-hero
  display: flex
  justify-content: center
  margin: 8px 0 26px

.profile-avatar-frame
  width: 186px
  height: 186px
  border-radius: 50%
  overflow: hidden
  background: transparent
  border: none
  box-shadow: none

.profile-avatar
  display: block
  width: 100%
  height: 100%
  object-fit: cover
  object-position: center 20%
  transform: translate(10px, 55px)scale(1.6)
  transform-origin: center center
  border-radius: 0
  max-width: none

@media (max-width: 767px)
  .profile-avatar-frame
    width: 180px
    height: 180px
  .profile-avatar
    transform: scale(1.1)

.gallery-photo-title
  font-weight: 600
  line-height: 1.35
  color: #1c2733

.gallery-photo-caption
  margin: 0
  color: #677381
  line-height: 1.7
  font-size: 0.92rem

.gallery-photo-meta
  font-size: 0.8rem
  color: #8b97a3
  letter-spacing: 0.02em

.gallery-empty
  padding: 24px
  border-radius: 16px
  background: #f7f9fb
  color: #61707f

@media (max-width: 991px)
  .gallery-album-header
    flex-direction: column
    align-items: flex-start

  .gallery-album-meta
    align-items: flex-start
    text-align: left

@media (max-width: 767px)
  .gallery-photo-grid
    column-count: 1
